FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/Monitor.Contracts/*.csproj src/Monitor.Contracts/
COPY src/Monitor.Core/*.csproj src/Monitor.Core/
COPY src/Monitor.Alerting/*.csproj src/Monitor.Alerting/
RUN dotnet restore src/Monitor.Alerting
COPY src ./src
RUN dotnet publish src/Monitor.Alerting -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /out .
USER $APP_UID
ENTRYPOINT ["dotnet", "Monitor.Alerting.dll"]
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/Monitor.Contracts/*.csproj src/Monitor.Contracts/
COPY src/Monitor.Core/*.csproj src/Monitor.Core/
COPY src/Monitor.Api/*.csproj src/Monitor.Api/
RUN dotnet restore src/Monitor.Api
COPY src ./src
RUN dotnet publish src/Monitor.Api -c Release -o /out --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /out .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Monitor.Api.dll"]